# Template for android/keystore.properties (release signing config).
#
# 1. Copy this file:  cp keystore.properties.template keystore.properties
# 2. Generate a release keystore (adjust alias/CN/validity to taste):
#      keytool -genkeypair -v \
#        -keystore penboard-release.keystore \
#        -storetype PKCS12 \
#        -alias penboard \
#        -keyalg RSA -keysize 4096 \
#        -validity 10000 \
#        -dname "CN=PenBoard"
# 3. Fill in the real values below.
#
# keystore.properties is gitignored (see ../.gitignore) -- it and any
# *.keystore/*.jks file must NEVER be committed. Without this file present,
# :app:assembleRelease still succeeds by falling back to the debug signing
# config (with a build warning) so contributors can build without a keystore.

# Path to the keystore file, relative to this android/ directory.
storeFile=penboard-release.keystore

# Password protecting the keystore file itself.
storePassword=CHANGE_ME

# Alias of the key entry to use for signing.
keyAlias=penboard

# Password protecting that key entry.
keyPassword=CHANGE_ME
