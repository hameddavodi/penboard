<?xml version="1.0" encoding="utf-8"?>
<!-- allowBackup=false already disables classic adb/cloud backup, but Android
     12+ separately governs cloud backup and device-to-device transfer via
     this file. This app holds no user data worth transferring either way. -->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapability="false">
        <exclude domain="root" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
    </device-transfer>
</data-extraction-rules>
